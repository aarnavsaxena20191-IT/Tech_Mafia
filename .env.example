NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/findhacker?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_REGISTRATION_KEY=replace-with-a-separate-random-key-at-least-32-characters
